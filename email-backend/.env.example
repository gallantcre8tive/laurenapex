# Copy this file to .env and fill in real values
PORT=5050

# Gmail (recommended): use an App Password (Google Account → Security → 2FA → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_char_app_password

# Shown as the From name/address in emails
MAIL_FROM_NAME=Lauren Apex Global
MAIL_FROM_EMAIL=yourgmail@gmail.com

# Optional: comma-separated origins allowed (default allows all for local testing)
# CORS_ORIGIN=http://127.0.0.1:5500,https://laurenapex.vercel.app
